VITE_APP_ENV=development
VITE_APP_NAME=Mitdo

# Browser calls the services on the public host, not localhost.
VITE_API_BASE_URL=http://mitdo.tech:8080

# Garden data (review / tempo / collection) — mdg-tempo-svc.
VITE_TEMPO_API_BASE_URL=http://mitdo.tech:8081

# Optional Vite proxy target (unused when VITE_API_BASE_URL is absolute).
AUTH_API_ORIGIN=http://mitdo.tech:8080
TEMPO_API_ORIGIN=http://mitdo.tech:8081
