# Vite loads env by mode: development | test | production
#   .env                  shared
#   .env.development      npm run dev
#   .env.test             npm run build:test / preview:test
#   .env.production       npm run build
#   .env*.local           gitignored machine overrides (highest priority among files)
#
# Browser-exposed keys MUST use VITE_ prefix.
# AUTH_API_ORIGIN is server-only (dev proxy target) — never prefix with VITE_.

VITE_APP_ENV=development
VITE_APP_NAME=Mitdo
# Dev: call auth-svc directly so /auth/me uses the cookie set on :8080.
VITE_API_BASE_URL=http://localhost:8080
# Garden API (mdg-tempo-svc). Leave empty to keep review/detail/collection local-only.
VITE_TEMPO_API_BASE_URL=http://localhost:8081/v1
AUTH_API_ORIGIN=http://localhost:8080
TEMPO_API_ORIGIN=http://localhost:8081

