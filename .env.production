VITE_APP_ENV=production
VITE_APP_NAME=Mitdo

# Browser calls the services on the public host, not localhost.
VITE_API_BASE_URL=https://api.mitdo.cloud/v1

# Garden data (review / tempo / collection) — mdg-tempo-svc.
VITE_TEMPO_API_BASE_URL=https://api.mitdo.cloud

# Optional Vite proxy target (unused when VITE_API_BASE_URL is absolute).
AUTH_API_ORIGIN=https://api.mitdo.cloud
TEMPO_API_ORIGIN=http://api.mitdo.cloud:8081
