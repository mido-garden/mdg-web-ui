VITE_APP_ENV=production
VITE_APP_NAME=Mitdo

# Public API hosts. The /v1 prefix is not used by production URLs.
VITE_API_BASE_URL=https://api.mitdo.cloud
VITE_TEMPO_API_BASE_URL=https://api.mitdo.cloud

# Optional Vite proxy target (unused because the production API URLs are absolute).
AUTH_API_ORIGIN=https://api.mitdo.cloud
TEMPO_API_ORIGIN=https://api.mitdo.cloud
